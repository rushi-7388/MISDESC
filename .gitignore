# ==============================================================================
# Git Ignore Configuration for Cheque Truncation System (MISDESC)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
# Keep example/template files tracked for developer reference
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template

# ------------------------------------------------------------------------------
# 3. User Uploads, Media & Storage
# ------------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
storage/
temp/
tmp/

# ------------------------------------------------------------------------------
# 4. Database Dumps, Backups & Local Databases
# ------------------------------------------------------------------------------
backups/
*.dump
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sql
*.sql.gz
# Never ignore Prisma schema migrations
!**/prisma/migrations/**
!**/prisma/migrations/**/*.sql

# ------------------------------------------------------------------------------
# 5. Production Builds & Compiled Output
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. Runtime Caches & Temporary Files
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ------------------------------------------------------------------------------
# 8. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
.playwright/

# ------------------------------------------------------------------------------
# 9. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 10. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# 11. Docker & Local Orchestration Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
*.local.yml

# ------------------------------------------------------------------------------
# 12. Cryptographic Key Materials, Certs & HSM Emulators
# ------------------------------------------------------------------------------
*.pem
*.key
*.priv
*.pfx
*.p12
*.cer
*.crt
*.der
!backend/prisma/seed-certs/**
hsm_storage/
ceremony_vault/
m-of-n-shards/

# ------------------------------------------------------------------------------
# 13. Zero-Knowledge Proof (ZKP) Circuits & Prover ArtifaMISDESC
# ------------------------------------------------------------------------------
*.zkey
*.ptau
*.wtns
*.r1cs
circuits/build/

# ------------------------------------------------------------------------------
# 14. Performance Profiles, Heap Dumps & Scratch
# ------------------------------------------------------------------------------
*.heapsnapshot
*.cpuprofile
core
core.*
scratch/

