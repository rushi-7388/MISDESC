generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRESENTING_BANK
  DRAWEE_BANK
  ADMIN
  BRANCH_MANAGER
  IT_STAFF
  COMPLIANCE_AUDITOR
  SETTLEMENT_OFFICER
}

enum ChequeStatus {
  PRESENTED
  VERIFIED
  AWAITING_CHECKER
  CLEARED
  RETURNED
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum BatchStatus {
  OPEN
  LOCKED
  RECONCILED
  SETTLED
}

model Bank {
  id       String @id @default(uuid())
  name     String
  ifsc     String @unique
  code     String @unique

  users            User[]
  presentedCheques   Cheque[]            @relation("PresentingBank")
  draweeCheques      Cheque[]            @relation("DraweeBank")
  positivePayRecords PositivePayRecord[]

  // Intraday Liquidity, DRM Disputes & PKI Relations
  liquidityPool       LiquidityPool?
  digitalCertificates DigitalCertificate[]
  initiatedDisputes   DisputeClaim[]       @relation("InitiatedDisputes")
  respondentDisputes  DisputeClaim[]       @relation("RespondentDisputes")

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  branchName String?

  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id])

  uploadedCheques Cheque[]        @relation("UploadedBy")
  actedEvents     ClearingEvent[] @relation("ActedBy")

  // Dispute Governance Relations
  filedDisputes    DisputeClaim[]    @relation("FiledDisputes")
  resolvedDisputes DisputeClaim[]    @relation("ResolvedDisputes")
  disputeLogs      DisputeAuditLog[]

  createdAt DateTime @default(now())
}

model Batch {
  id          String      @id @default(uuid())
  sessionName String
  sessionCode String      @unique
  status      BatchStatus @default(OPEN)
  totalCount  Int         @default(0)
  totalAmount Decimal     @default(0) @db.Decimal(14, 2)
  cheques     Cheque[]
  closedAt    DateTime?

  // Clearing Cutoff Windows & Two-Way Reconciliation
  windowType           String?               @default("STANDARD_CYCLE")
  cutoffAt             DateTime?
  reconciledAt         DateTime?
  discrepancyCount     Int                   @default(0)
  discrepancyAmount    Decimal               @default(0) @db.Decimal(14, 2)
  reconciliationReport Json?
  signatures           BatchSignatureAudit[]
  pqcManifests         PqcManifest[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Cheque {
  id            String       @id @default(uuid())
  chequeNumber  String
  micrCode      String
  accountNumber String
  ifsc          String
  amount        Decimal      @db.Decimal(12, 2)
  payeeName     String
  imageUrl      String?
  imageHash     String?
  status        ChequeStatus @default(PRESENTED)
  returnReason  String?

  // Enterprise Risk & Compliance
  riskScore     Float        @default(0)
  riskTier      RiskTier     @default(LOW)
  riskFactors   Json?

  // Positive Pay System (PPS) Compliance
  ppsStatus           String?      @default("PPS_NOT_REGISTERED")
  ppsDiscrepancy      Json?

  // AI 1:1 Specimen Signature Engine
  signatureMatchScore Float?       @default(94.8)
  signatureStatus     String?      @default("VERIFIED")

  // Maker-Checker 4-Eyes Governance
  makerId       String?
  checkerId     String?

  // RBI Continuous Clearing & e-Kuber On-Realisation Gateway
  ekuberUtr               String?
  ekuberRef               String?
  settledAt               DateTime?
  settlementMode          String?      @default("CONTINUOUS_T0")
  beneficiaryCreditStatus String?      @default("PENDING")

  // Clearing Batch Association
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id])
  branchName    String?      @default("Athwa Lines Branch")
  branchManagerApproved Boolean? @default(true)

  presentingBankId String
  presentingBank   Bank   @relation("PresentingBank", fields: [presentingBankId], references: [id])

  draweeBankId String
  draweeBank   Bank   @relation("DraweeBank", fields: [draweeBankId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  events     ClearingEvent[]
  fraudFlags FraudFlag[]
  disputes   DisputeClaim[]

  // Intraday Liquidity Reservation
  liquidityReservationRef String?

  // Next-Gen Fintech Engines Relations
  smartContract  SmartChequeContract?
  microLien      MicroLien?
  zkProofRecords ZkProofRecord[]
  swarmDockets   SwarmDocket[]
  sanctionsLogs  SanctionsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FraudFlagType {
  DUPLICATE_IMAGE
  DUPLICATE_CHEQUE_NUMBER
  VELOCITY
  HIGH_VALUE
  ANOMALOUS_AMOUNT
}

enum FraudFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

model FraudFlag {
  id       String            @id @default(uuid())
  chequeId String
  cheque   Cheque            @relation(fields: [chequeId], references: [id])

  type     FraudFlagType
  severity FraudFlagSeverity @default(MEDIUM)
  details  String

  resolved   Boolean  @default(false)
  resolvedBy String?

  createdAt DateTime @default(now())
}

model ClearingEvent {
  id         String   @id @default(uuid())
  chequeId   String
  cheque     Cheque   @relation(fields: [chequeId], references: [id])

  fromStatus String?
  toStatus   String
  remarks    String?

  // Cryptographic Ledger Blockchain Chaining
  hash       String?
  prevHash   String?

  actorId String?
  actor   User?  @relation("ActedBy", fields: [actorId], references: [id])

  createdAt DateTime @default(now())
}

model Settlement {
  id        String   @id @default(uuid())
  cycleDate DateTime @default(now())

  bankAId   String
  bankBId   String
  netAmount Decimal  @db.Decimal(12, 2)
  direction String

  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(uuid())
  source    String   // "frontend" or "backend"
  level     String   @default("error") // "error", "warn", "info"
  message   String
  stack     String?
  url       String?
  userAgent String?
  context   Json?
  createdAt DateTime @default(now())
}

model PositivePayRecord {
  id            String   @id @default(uuid())
  accountNumber String
  chequeNumber  String
  payeeName     String
  amount        Decimal  @db.Decimal(12, 2)
  chequeDate    DateTime
  status        String   @default("REGISTERED") // REGISTERED, MATCHED, DISCREPANT

  bankId        String
  bank          Bank     @relation(fields: [bankId], references: [id])

  createdAt     DateTime @default(now())

  @@unique([accountNumber, chequeNumber])
}

// ============================================================================
// 1. Central Bank Intraday Liquidity & Collateral Reservation System (LMS)
// ============================================================================
enum LiquidityStatus {
  HEALTHY
  WARNING
  BREACHED
  BLOCKED
}

enum LiquidityEventType {
  COLLATERAL_DEPOSIT
  EXPOSURE_INCREASE
  EXPOSURE_RELEASE
  SETTLEMENT_SETTLE
  LIMIT_BREACH
}

model LiquidityPool {
  id                      String          @id @default(uuid())
  bankId                  String          @unique
  bank                    Bank            @relation(fields: [bankId], references: [id])
  allocatedCollateral     Decimal         @default(10000000.00) @db.Decimal(14, 2)
  creditLine              Decimal         @default(2000000.00) @db.Decimal(14, 2)
  currentExposure         Decimal         @default(0.00) @db.Decimal(14, 2)
  reservedAmount          Decimal         @default(0.00) @db.Decimal(14, 2)
  warningThresholdPercent Float           @default(80.0)
  breachThresholdPercent  Float           @default(95.0)
  status                  LiquidityStatus @default(HEALTHY)

  events                  LiquidityEvent[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model LiquidityEvent {
  id                      String             @id @default(uuid())
  poolId                  String
  pool                    LiquidityPool      @relation(fields: [poolId], references: [id])
  eventType               LiquidityEventType
  amount                  Decimal            @db.Decimal(14, 2)
  utilizationPercentAfter Float
  referenceId             String?
  remarks                 String?
  createdAt               DateTime           @default(now())
}

// ============================================================================
// 2. Clearing Dispute Resolution & Chargeback Engine (NPCI MISDESC DRM)
// ============================================================================
enum DisputeType {
  UNAUTHORIZED_DEBIT
  AMOUNT_MISMATCH
  DUPLICATE_PRESENTATION
  LATE_RETURN
  FORGED_SIGNATURE
  PPS_BREACH
}

enum DisputeStatus {
  FILED
  UNDER_REVIEW
  EVIDENCE_REQUESTED
  RESOLVED_CLAIMANT
  RESOLVED_RESPONDENT
  ESCALATED_RBI_OMBUDSMAN
  CLOSED
}

model DisputeClaim {
  id                String         @id @default(uuid())
  claimNumber       String         @unique
  chequeId          String
  cheque            Cheque         @relation(fields: [chequeId], references: [id])
  initiatingBankId  String
  initiatingBank    Bank           @relation("InitiatedDisputes", fields: [initiatingBankId], references: [id])
  respondentBankId  String
  respondentBank    Bank           @relation("RespondentDisputes", fields: [respondentBankId], references: [id])
  disputeType       DisputeType
  claimAmount       Decimal        @db.Decimal(12, 2)
  status            DisputeStatus  @default(FILED)
  filedById         String
  filedBy           User           @relation("FiledDisputes", fields: [filedById], references: [id])
  resolvedById      String?
  resolvedBy        User?          @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  evidenceNotes     String
  resolutionSummary String?
  slaDeadline       DateTime
  logs              DisputeAuditLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model DisputeAuditLog {
  id          String         @id @default(uuid())
  disputeId   String
  dispute     DisputeClaim   @relation(fields: [disputeId], references: [id])
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id])
  fromStatus  DisputeStatus?
  toStatus    DisputeStatus
  actionNotes String?
  createdAt   DateTime       @default(now())
}

// ============================================================================
// 3. Public Key Infrastructure (PKI) & Digital Signature Registry
// ============================================================================
enum CertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model DigitalCertificate {
  id              String                @id @default(uuid())
  bankId          String
  bank            Bank                  @relation(fields: [bankId], references: [id])
  certThumbprint  String                @unique
  serialNumber    String                @unique
  issuer          String                @default("MISDESC National PKI Root Trust CA")
  subject         String
  validFrom       DateTime
  validTo         DateTime
  status          CertificateStatus     @default(ACTIVE)
  keyAlgorithm    String                @default("RSA-4096 / SHA-256")
  batchSignatures BatchSignatureAudit[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model BatchSignatureAudit {
  id                String             @id @default(uuid())
  batchId           String
  batch             Batch              @relation(fields: [batchId], references: [id])
  certificateId     String
  certificate       DigitalCertificate @relation(fields: [certificateId], references: [id])
  signatureDigest   String
  payloadDigest     String
  verified          Boolean            @default(true)
  verificationNotes String?
  signedAt          DateTime           @default(now())
}

// ============================================================================
// 4. Programmable Smart Cheques & Micro-Lien Escrows
// ============================================================================
model SmartChequeContract {
  id                String            @id @default(uuid())
  contractId        String            @unique
  chequeId          String            @unique
  cheque            Cheque            @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  totalAmount       Decimal           @db.Decimal(14, 2)
  taxRatePercent    Float             @default(18.0)
  taxDeductedAmount Decimal           @db.Decimal(14, 2)
  netVendorAmount   Decimal           @db.Decimal(14, 2)
  taxAuthority      String            @default("GSTN / CBDT")
  taxChallanRef     String?
  programmableState String            @default("ACTIVE") // ACTIVE, SATISFIED, REVOKED
  cbdcSettled       Boolean           @default(false)
  cbdcReceipt       Json?
  milestones        EscrowMilestone[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model EscrowMilestone {
  id            String              @id @default(uuid())
  contractId    String
  contract      SmartChequeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stepId        String              // M1_PRESENTATION_CLEARANCE, M2_DELIVERY_SIGN_OFF
  name          String
  payoutPercent Float
  amount        Decimal             @db.Decimal(14, 2)
  status        String              @default("PENDING") // SATISFIED, PENDING_IOT_CONFIRMATION
  releasedAt    DateTime?
  createdAt     DateTime            @default(now())
}

model MicroLien {
  id               String   @id @default(uuid())
  lienId           String   @unique
  chequeId         String   @unique
  cheque           Cheque   @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  drawerAccount    String
  earmarkedAmount  Decimal  @db.Decimal(14, 2)
  status           String   @default("LOCKED_IN_ESCROW")
  bounceRisk       String   @default("0.0%")
  cbsLockReference String
  holdExpiry       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// 5. Zero-Knowledge Confidential Clearing (zk-SNARK Groth16 / BN254)
// ============================================================================
model ZkProofRecord {
  id               String   @id @default(uuid())
  proofId          String   @unique
  chequeId         String
  cheque           Cheque   @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  protocol         String   @default("Groth16")
  curve            String   @default("BN254")
  provingTimeMs    Float
  publicSignals    Json
  proofPiA         Json
  proofPiB         Json
  proofPiC         Json
  verified         Boolean  @default(true)
  pairingEquation  String?
  createdAt        DateTime @default(now())
}

// ============================================================================
// 6. Post-Quantum Cryptography (NIST FIPS 204 ML-DSA / FIPS 203 ML-KEM)
// ============================================================================
model PqcManifest {
  id                 String   @id @default(uuid())
  manifestId         String   @unique
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  bankCode           String
  algorithm          String   @default("ML-DSA-65")
  classicalDigest    String
  pqcDigest          String
  dualLayerSignature Json
  latticeNormBound   Float
  latticeVerified    Boolean  @default(true)
  kemEncapsulation   Json?
  signedAt           DateTime @default(now())
}

// ============================================================================
// 7. Autonomous 4-Agent Swarm Adjudication & Forensic Dockets
// ============================================================================
model SwarmDocket {
  id             String   @id @default(uuid())
  docketId       String   @unique
  chequeId       String
  cheque         Cheque   @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  consensusScore Float
  verdict        String   // STP_CLEARED_AUTONOMOUS, ESCALATED_HUMAN_REVIEW
  stpExecuted    Boolean  @default(false)
  durationMs     Float
  sealedProof    String
  agentResults   Json     // Array of 4 agent outputs & metrics
  criticalFlags  Json     // Flags array
  createdAt      DateTime @default(now())
}

// ============================================================================
// 8. International Sanctions & PEP Watchlist Audit Radar
// ============================================================================
model SanctionsLog {
  id                  String   @id @default(uuid())
  screeningRef        String   @unique
  chequeId            String?
  cheque              Cheque?  @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  drawerName          String
  payeeName           String
  countryOrigin       String   @default("IN")
  verdict             String   // CLEARED_INTERNATIONAL_CLEARING, SANCTIONS_BLOCKED_OFAC_VIOLATION, etc.
  isBlocked           Boolean  @default(false)
  isFlagged           Boolean  @default(false)
  screeningDurationMs Float
  matches             Json
  auditorOverride     Boolean  @default(false)
  overrideBy          String?
  overrideNotes       String?
  createdAt           DateTime @default(now())
}

// ============================================================================
// 9. Multi-Tenant Core Banking (CBS) Webhook Gateway & Open Banking APIs
// ============================================================================
model WebhookSubscription {
  id          String   @id @default(uuid())
  bankCode    String   // e.g. "SBIN", "HDFC", "FINACLE_CORP", "FLEXCUBE_01"
  systemName  String   @default("CORE_BANKING_SYSTEM") // "Finacle", "TCS BaNCS", "Oracle Flexcube"
  targetUrl   String
  secretKey   String   // HMAC-SHA256 signing secret
  events      Json     // Array of subscribed events ["CHEQUE_PRESENTED", "LIEN_EARMARKED", "LSM_CYCLE_SETTLED", "DISPUTE_FILED"]
  isActive    Boolean  @default(true)
  deliveries  WebhookDelivery[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  payload        Json
  signature      String   // HMAC-SHA256 signature
  statusCode     Int?
  responseBody   String?
  attempts       Int      @default(1)
  status         String   // DELIVERED, FAILED, RETRYING
  createdAt      DateTime @default(now())
}

// ============================================================================
// 10. Bank MIS & Statutory Regulatory Reporting Engine
// ============================================================================
enum ReportType {
  DAILY_CLEARING_SUMMARY
  RBI_STATUTORY_RETURN
  HIGH_VALUE_PPS_RECON
  INTERBANK_SETTLEMENT_MNS
  BRANCH_OPERATIONS_AUDIT
  FORENSIC_FRAUD_EXCEPTION
  CHEQUE_RETURN_ANALYSIS
  CUSTOMER_EXPOSURE_MIS
  SESSION_RECONCILIATION_AUDIT
  INTRADAY_LIQUIDITY_BUFFER
  BRANCH_SLA_PERFORMANCE
  SUSPICIOUS_VELOCITY_AML
}

enum ReportFormat {
  PDF
  CSV
  XLSX
  JSON
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

model BankReport {
  id              String       @id @default(uuid())
  reportRef       String       @unique
  reportType      ReportType
  title           String
  description     String?
  format          ReportFormat @default(CSV)
  status          ReportStatus @default(COMPLETED)
  bankName        String       @default("SURAT PEOPLES CO OP BANK")
  branchName      String?
  generatedByRole String
  generatedByName String
  generatedByEmail String
  dateFrom        DateTime?
  dateTo          DateTime?
  recordCount     Int          @default(0)
  totalAmount     Float        @default(0.0)
  clearedAmount   Float        @default(0.0)
  returnedAmount  Float        @default(0.0)
  parameters      Json?
  summaryData     Json?
  tabularData     Json?
  downloadUrl     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}


