# MISDESC Backend Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://MISDESC:MISDESC_password@localhost:5432/MISDESC_system?schema=public"

# JWT Authentication Secret Key (generate a strong random secret in production)
JWT_SECRET="replace_with_a_secure_random_secret_string"

# Backend Server Port
PORT=5000
